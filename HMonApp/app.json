{
  "expo": {
    "name": "HMon",
    "slug": "hmon-hydroponics-monitor",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "hmon",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "primaryColor": "#3aaa35",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "edu.bau.hmon",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "HMon uses the camera to take standardized weekly photos of the hydroponic system and individual plants for the HAI education project.",
        "NSPhotoLibraryUsageDescription": "HMon accesses your photo library so you can upload plant photos for leaf-area analysis and AI processing.",
        "NSPhotoLibraryAddUsageDescription": "HMon may save processed plant photos back to your library when you export them."
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "edu.bau.hmon",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "CAMERA",
        "READ_MEDIA_IMAGES",
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES"
      ],
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "experiments": {
      "baseUrl": "/hmon-app"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "HMon accesses your photos so you can upload weekly plant images.",
          "cameraPermission": "HMon uses the camera to take standardized weekly plant photos."
        }
      ],
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "projectId": "REPLACE_WITH_EAS_PROJECT_ID"
      }
    },
    "owner": "REPLACE_WITH_EXPO_USERNAME",
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
